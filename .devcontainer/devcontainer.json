{
  "name": "Agent Workshop",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "node",
  "hostRequirements": {
    "cpus": 2
  },
  "containerEnv": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-vscode.live-server"]
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
