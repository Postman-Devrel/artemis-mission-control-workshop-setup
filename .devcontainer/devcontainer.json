{
  "name": "Agent Workshop",
  "image": "ghcr.io/postman-devrel-workshops/artemis-mission-control-workshop-image:latest",
  "remoteUser": "node",
  "hostRequirements": {
    "cpus": 2
  },
  "containerEnv": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.live-server"
      ],
      "settings": {
        "livePreview.openPreviewTarget": "External Browser"
      }
    }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh"
}
